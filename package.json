{
  "name": "vscode-epub",
  "displayName": "EPUB Reader",
  "description": "在 VS Code 中阅读本地 EPUB 电子书：真分页阅读、自定义排版、自动记忆阅读进度。像打开普通文件一样双击即可阅读。",
  "version": "1.0.0",
  "publisher": "local",
  "author": {
    "name": "转塘第一大作手"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "epub",
    "reader",
    "ebook",
    "epub reader",
    "电子书",
    "阅读器"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kakaoracle/vscode-epub.git"
  },
  "homepage": "https://github.com/kakaoracle/vscode-epub#readme",
  "bugs": {
    "url": "https://github.com/kakaoracle/vscode-epub/issues"
  },
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "pricing": "Free",
  "main": "./src/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onCustomEditor:vscodeEpub.epubReader"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscodeEpub.epubReader",
        "displayName": "EPUB 阅读器",
        "selector": [
          {
            "filenamePattern": "*.epub"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "vscodeEpub.openFile",
        "title": "打开 EPUB 文件…",
        "category": "EPUB Reader"
      },
      {
        "command": "vscodeEpub.recent",
        "title": "最近阅读的书",
        "category": "EPUB Reader"
      },
      {
        "command": "vscodeEpub.prevPage",
        "title": "上一页",
        "category": "EPUB Reader",
        "icon": "$(chevron-left)"
      },
      {
        "command": "vscodeEpub.nextPage",
        "title": "下一页",
        "category": "EPUB Reader",
        "icon": "$(chevron-right)"
      },
      {
        "command": "vscodeEpub.toggleToc",
        "title": "切换目录",
        "category": "EPUB Reader",
        "icon": "$(list-unordered)"
      },
      {
        "command": "vscodeEpub.openSettings",
        "title": "打开阅读器设置",
        "category": "EPUB Reader",
        "icon": "$(gear)"
      },
      {
        "command": "vscodeEpub.clearProgress",
        "title": "清除本书阅读进度",
        "category": "EPUB Reader"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vscodeEpub.openFile",
          "when": "resourceExtname == .epub",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "vscodeEpub.prevPage",
          "when": "activeCustomEditorId == 'vscodeEpub.epubReader'",
          "group": "navigation@1"
        },
        {
          "command": "vscodeEpub.nextPage",
          "when": "activeCustomEditorId == 'vscodeEpub.epubReader'",
          "group": "navigation@2"
        },
        {
          "command": "vscodeEpub.toggleToc",
          "when": "activeCustomEditorId == 'vscodeEpub.epubReader'",
          "group": "navigation@3"
        },
        {
          "command": "vscodeEpub.openSettings",
          "when": "activeCustomEditorId == 'vscodeEpub.epubReader'",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "vscodeEpub.prevPage",
          "when": "activeCustomEditorId == 'vscodeEpub.epubReader'"
        },
        {
          "command": "vscodeEpub.nextPage",
          "when": "activeCustomEditorId == 'vscodeEpub.epubReader'"
        },
        {
          "command": "vscodeEpub.toggleToc",
          "when": "activeCustomEditorId == 'vscodeEpub.epubReader'"
        },
        {
          "command": "vscodeEpub.openSettings",
          "when": "activeCustomEditorId == 'vscodeEpub.epubReader'"
        },
        {
          "command": "vscodeEpub.clearProgress",
          "when": "activeCustomEditorId == 'vscodeEpub.epubReader'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vscodeEpub.prevPage",
        "key": "left",
        "when": "activeCustomEditorId == 'vscodeEpub.epubReader' && !inputFocus"
      },
      {
        "command": "vscodeEpub.nextPage",
        "key": "right",
        "when": "activeCustomEditorId == 'vscodeEpub.epubReader' && !inputFocus"
      },
      {
        "command": "vscodeEpub.prevPage",
        "key": "alt+left",
        "when": "activeCustomEditorId == 'vscodeEpub.epubReader' && !inputFocus"
      },
      {
        "command": "vscodeEpub.nextPage",
        "key": "alt+right",
        "when": "activeCustomEditorId == 'vscodeEpub.epubReader' && !inputFocus"
      },
      {
        "command": "vscodeEpub.openSettings",
        "key": "alt+s",
        "when": "activeCustomEditorId == 'vscodeEpub.epubReader' && !inputFocus"
      },
      {
        "command": "vscodeEpub.toggleToc",
        "key": "alt+t",
        "when": "activeCustomEditorId == 'vscodeEpub.epubReader' && !inputFocus"
      }
    ],
    "configuration": {
      "title": "EPUB Reader",
      "properties": {
        "vscodeEpub.fontSize": {
          "type": "number",
          "default": 18,
          "minimum": 12,
          "maximum": 40,
          "description": "正文字号（px）"
        },
        "vscodeEpub.lineHeight": {
          "type": "number",
          "default": 1.8,
          "minimum": 1,
          "maximum": 3,
          "description": "行间距（倍数）"
        },
        "vscodeEpub.paragraphSpacing": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 3,
          "description": "段间距（em）"
        },
        "vscodeEpub.fontFamily": {
          "type": "string",
          "default": "",
          "description": "正文字体家族，留空则使用系统默认字体。例：\"Microsoft YaHei\", \"Noto Serif SC\", serif"
        },
        "vscodeEpub.theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "sepia",
            "dark",
            "green"
          ],
          "enumDescriptions": [
            "跟随 VS Code 主题",
            "明亮",
            "纸质（米黄）",
            "深色",
            "护眼绿"
          ],
          "description": "阅读配色主题"
        },
        "vscodeEpub.textColor": {
          "type": "string",
          "default": "",
          "description": "自定义正文字色（如 #333333），留空则使用主题配色"
        },
        "vscodeEpub.backgroundColor": {
          "type": "string",
          "default": "",
          "description": "自定义背景色（如 #f5f0e6），留空则使用主题配色"
        },
        "vscodeEpub.pageMode": {
          "type": "string",
          "default": "page",
          "enum": [
            "page",
            "scroll"
          ],
          "enumDescriptions": [
            "整页翻页：一次翻过一整屏，栏数设置生效",
            "连续滚动：内容像网页一样纵向流动，滚轮自由滚动（此时固定为单栏）"
          ],
          "description": "翻页方式"
        },
        "vscodeEpub.columns": {
          "type": "number",
          "default": 1,
          "enum": [
            1,
            2,
            3
          ],
          "description": "每屏显示的栏数（多栏时一次翻过一整屏；连续滚动模式下固定为单栏）"
        },
        "vscodeEpub.columnGap": {
          "type": "number",
          "default": 40,
          "minimum": 0,
          "maximum": 120,
          "description": "栏间距（px）"
        },
        "vscodeEpub.pageMargin": {
          "type": "number",
          "default": 48,
          "minimum": 0,
          "maximum": 160,
          "description": "页面左右边距（px）"
        },
        "vscodeEpub.textAlign": {
          "type": "string",
          "default": "justify",
          "enum": [
            "justify",
            "left"
          ],
          "description": "正文对齐方式"
        },
        "vscodeEpub.rememberProgress": {
          "type": "boolean",
          "default": true,
          "description": "自动记忆并恢复每本书的阅读进度"
        },
        "vscodeEpub.showPageNumber": {
          "type": "boolean",
          "default": true,
          "description": "底部显示页码/进度信息"
        }
      }
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.epub": "vscodeEpub.epubReader"
      }
    }
  },
  "scripts": {
    "samples": "node ./tools/make-sample-epub.js",
    "icon": "node ./tools/make-icon.js",
    "test": "node ./tools/test-parse.js && node ./tools/run-browser-check.js",
    "test:parse": "node ./tools/test-parse.js",
    "test:browser": "node ./tools/run-browser-check.js",
    "package": "npx --yes @vscode/vsce@latest package --no-git-tag-version --no-update-package-json --out vscode-epub.vsix",
    "install-local": "code --install-extension ./vscode-epub.vsix --force",
    "publish:marketplace": "npx --yes @vscode/vsce@latest publish --no-git-tag-version --no-update-package-json"
  }
}
